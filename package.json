{
  "name": "mdl-beaussier",
  "version": "1.0.0",
  "description": "Application web dédiée à la vie associative et aux événements de l'école (MDL Beaussier)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "nodejs",
